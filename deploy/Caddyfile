# Caddy gets and renews the HTTPS certificate on its own — this is the whole
# TLS setup. Replace the hostname with yours (a free DuckDNS name is fine).
rent-planes.duckdns.org {
	reverse_proxy 127.0.0.1:3000

	encode gzip
	log {
		output file /var/log/caddy/planesforfriends.log
		format console
	}
}
